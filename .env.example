# Secrets stay local (ground rule 13). Copy to .env — never commit .env.

LOG_LEVEL=INFO
LOG_FORMAT=json
BIND=127.0.0.1
PORT=8787
GATEWAY_USE_FAKE=true

# Live LLM is opt-in. Default pytest uses a Fake LLM.
# Slice 1 live path is a stub until keys exist; still no vendor SDK in pytest.
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
GOOGLE_API_KEY=
DEFAULT_PROVIDER=xai
DEFAULT_XAI_MODEL=grok-4.3
DEFAULT_GEMINI_MODEL=gemini-2.5-flash
MAX_PROMPT_CHARS=2000
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=2
GRAPH_RECURSION_LIMIT=5
GRAPH_MAX_STEPS=5
TEMPERATURE=0
MAX_TOKENS=1024

# Langfuse is observability, not required. App must run with this false.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
