# Secrets stay local (ground rule 13). Copy to .env — never commit .env.

LOG_LEVEL=INFO

# Live LLM is opt-in. Default pytest uses a Fake LLM (Phase 1+).
# xAI / SpaceXAI (OpenAI-compatible): https://api.x.ai/v1
XAI_API_KEY=

# Langfuse is observability, not required. App must run with this false.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
